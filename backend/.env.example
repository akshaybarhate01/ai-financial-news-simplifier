# ==============================================================================
# AI Financial News Simplifier - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL for Docker/Production, SQLite default for zero-config local dev)
DATABASE_URL=sqlite:///./financial_news.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_news

# JWT Authentication
SECRET_KEY=financial-news-simplifier-super-secret-jwt-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model Configuration (Groq Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# External Financial News API
# Get your free key at: https://newsapi.org/
NEWS_API_KEY=

# Security & Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
PROMPT_INJECTION_DEFENSE_STRICT=True
MAX_PROMPT_TOKENS=2000
